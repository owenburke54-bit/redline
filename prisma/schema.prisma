generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String?
  password           String?
  stravaId           String?   @unique
  stravaAccessToken  String?
  stravaRefreshToken String?
  stravaTokenExpiry  DateTime?
  whoopId            String?   @unique
  whoopAccessToken   String?
  whoopRefreshToken  String?
  whoopTokenExpiry   DateTime?
  garminUserId             String?   @unique
  garminAccessToken        String?
  garminAccessTokenSecret  String?
  garminOAuthToken         String?
  garminRequestTokenSecret String?
  dedicationScore    Int       @default(7)
  onboardingComplete Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts              Account[]
  sessions              Session[]
  events                Event[]
  plans                 TrainingPlan[]
  workouts              Workout[]
  stravaActivities      StravaActivity[]
  whoopActivities       WhoopActivity[]
  whoopRecoveries       WhoopRecovery[]
  garminDailySummaries  GarminDailySummary[]
  checkins              WeeklyCheckin[]
  athleteProfile        AthleteProfile?
  athleteModel          AthleteModel?
  weeklyBriefs          WeeklyBrief[]
  partnershipsSent      Partnership[]   @relation("PartnerSent")
  partnershipsReceived  Partnership[]   @relation("PartnerReceived")
  planAdaptations       PlanAdaptation[]
  passwordResetTokens   PasswordResetToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AthleteProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  yearsRunning          Int?
  weeklyMileageBaseline Int?
  injuryHistory         String?
  goalStatement         String?
  painToleranceRating   Int?

  inferredDedicationScore Float?
  avgWeeklyEffort         Float?
  consistencyScore        Float?
  classSchedule           Json?

  updatedAt DateTime @updatedAt
}

model Event {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id])

  name     String
  type     EventType
  date     DateTime
  location String?
  goalTime String?
  priority Int       @default(1)
  isActive Boolean   @default(true)

  plan      TrainingPlan?
  createdAt DateTime      @default(now())
}

enum EventType {
  FIVE_K
  TEN_K
  HALF_MARATHON
  MARATHON
  ULTRA_50K
  ULTRA_50M
  HYROX
  HYROX_WOMENS
  HYROX_DOUBLES
  HYROX_DOUBLES_MIXED
  HYROX_DOUBLES_MENS
  HYROX_DOUBLES_WOMENS
  TRIATHLON_SPRINT
  TRIATHLON_OLYMPIC
  HALF_IRONMAN
  IRONMAN
}

model TrainingPlan {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  eventId String @unique
  event   Event  @relation(fields: [eventId], references: [id])

  templateBase    PlanTemplate
  weeklyStructure Json
  aiOverrides     Json?

  currentWeek  Int        @default(1)
  totalWeeks   Int
  status       PlanStatus @default(ACTIVE)
  lastAiReview DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  workouts    Workout[]
  adaptations PlanAdaptation[]
}

enum PlanTemplate {
  HAL_HIGDON_NOVICE
  HAL_HIGDON_INTERMEDIATE
  HAL_HIGDON_ADVANCED
  HYROX_8WK
  HYROX_16WK
  HALF_MARATHON_12WK
  ULTRA_12WK
}

enum PlanStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ABANDONED
}

model Workout {
  id     String       @id @default(cuid())
  userId String
  user   User         @relation(fields: [userId], references: [id])
  planId String
  plan   TrainingPlan @relation(fields: [planId], references: [id])

  scheduledDate DateTime
  type          WorkoutType
  title         String
  description   String

  targetDistance Float?
  targetDuration Int?
  targetPace     String?
  intensityZone  Int?

  stations   Json?
  isHyroxSim Boolean @default(false)

  status           WorkoutStatus @default(SCHEDULED)
  stravaActivityId String?
  completedAt      DateTime?
  actualDistance   Float?
  actualDuration   Int?
  perceivedEffort  Int?

  aiModified     Boolean @default(false)
  aiModifyReason String?
  conflictFlag   Boolean @default(false)
  conflictNote   String?

  strengthBlocks      Json?
  warmup              String?
  cooldown            String?
  coachingCues        String?
  perceivedDifficulty PerceivedDifficulty?

  createdAt DateTime @default(now())
}

enum WorkoutType {
  EASY_RUN
  LONG_RUN
  TEMPO
  INTERVALS
  HYROX_STATION_WORK
  HYROX_SIM
  STRENGTH
  CROSS_TRAIN
  REST
  RACE
}

enum WorkoutStatus {
  SCHEDULED
  COMPLETED
  SKIPPED
  MODIFIED
}

enum PerceivedDifficulty {
  TOO_EASY
  ABOUT_RIGHT
  TOO_HARD
}

model StravaActivity {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  stravaId         String   @unique
  type             String
  name             String
  distance         Float
  movingTime       Int
  elapsedTime      Int
  startDate        DateTime
  averageHeartrate Float?
  maxHeartrate     Float?
  averageSpeed     Float?
  effortScore      Float?

  matchedWorkoutId String?

  createdAt DateTime @default(now())
}

model WeeklyCheckin {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  weekOf          DateTime
  perceivedEffort Int
  bodyFeel        Int
  completedCount  Int
  plannedCount    Int
  notes           String?

  aiResponse   String?
  planAdjusted Boolean @default(false)

  createdAt DateTime @default(now())
}

model ConflictLog {
  id     String @id @default(cuid())
  userId String

  detectedAt      DateTime @default(now())
  weekOf          DateTime
  conflictType    String
  description     String
  affectedPlanIds String[]
  aiSuggestion    String?
  resolved        Boolean  @default(false)
  resolvedBy      String?
}

model WhoopActivity {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  whoopId      String   @unique
  sportName    String
  startDate    DateTime
  endDate      DateTime
  strain       Float
  avgHeartRate Float?
  maxHeartRate Float?
  calories     Float?

  createdAt DateTime @default(now())
}

model WhoopRecovery {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  date          DateTime
  recoveryScore Float
  hrvRmssd      Float?
  restingHr     Float?
  sleepScore    Float?
  sleepDuration Int?

  createdAt DateTime @default(now())

  @@unique([userId, date])
}

model GarminDailySummary {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  date          DateTime
  bodyBattery   Float?
  stressAvg     Float?
  restingHr     Int?
  steps         Int?
  sleepScore    Float?
  sleepDuration Int?
  sleepHrv      Float?

  createdAt DateTime @default(now())

  @@unique([userId, date])
}

model Partnership {
  id          String        @id @default(cuid())
  requesterId String
  requester   User          @relation("PartnerSent", fields: [requesterId], references: [id], onDelete: Cascade)
  partnerId   String?
  partner     User?         @relation("PartnerReceived", fields: [partnerId], references: [id], onDelete: SetNull)
  inviteEmail String
  status      PartnerStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum PartnerStatus {
  PENDING
  ACTIVE
  DECLINED
}

model AthleteModel {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  // Banister impulse-response fitness model
  ctl            Float?  // chronic training load (42-day EWMA)
  atl            Float?  // acute training load (7-day EWMA)
  tsb            Float?  // training stress balance = CTL - ATL
  tssHistory     Json?   // TssEntry[]: [{ date: string, tss: number }]

  // Behavioral signals
  rpeAvg7d          Float?
  rpeAvg28d         Float?
  complianceRate28d Float?
  avgWeeklyMiles    Float?

  // Recovery patterns
  avgRecovery7d   Float?
  avgHrv7d        Float?
  avgSleepScore7d Float?

  // HYROX-specific projections
  projectedHyroxTime Float?
  stationReadiness   Float?

  // Risk and confidence
  weaknesses     String[]
  injuryRiskFlag Boolean  @default(false)
  injuryRiskNote String?
  dataConfidence Float    @default(0)

  lastComputedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model WeeklyBrief {
  id        String   @id @default(cuid())
  userId    String
  weekStart DateTime @db.Date
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
}

model PlanAdaptation {
  id     String       @id @default(cuid())
  userId String
  user   User         @relation(fields: [userId], references: [id])
  planId String
  plan   TrainingPlan @relation(fields: [planId], references: [id])

  adaptationType   AdaptationType
  severity         AdaptationSeverity
  triggerSignals   String[]
  weekRange        Json               // { from: number, to: number }
  workoutsModified Int                @default(0)
  coachSummary     String
  coachMessage     String

  appliedAt   DateTime  @default(now())
  dismissedAt DateTime?

  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique @default(cuid())
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum AdaptationType {
  LOAD_REDUCTION
  RECOVERY_WEEK
  RAMP_CORRECTION
  INTENSITY_SHIFT
  LOAD_INCREASE
}

enum AdaptationSeverity {
  LOW
  MEDIUM
  HIGH
}
